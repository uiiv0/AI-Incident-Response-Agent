# --- Option 1 (recommended): local Ollama, no limits ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=poolside/laguna-s-2.1:free

# --- Option 2: OpenRouter free model (rate limited) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<pick a ":free" model that supports tools>